PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# MongoDB Atlas or local MongoDB connection string.
# Percent-encode special characters in username/password: @ -> %40, # -> %23, % -> %25, ? -> %3F, / -> %2F
MONGO_URI=mongodb+srv://kamran:<Kamran123>@civicconnect.z7bwcys.mongodb.net/?appName=CivicConnect

# Use at least 32 characters locally and at least 64 random characters in production.
JWT_SECRET=a8f5f167f44f4964e6c998dee827110c8f5f167f44f4964e6
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_DAYS=1
COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Email is optional in development. Password reset responses include the reset URL when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CivicConnect <no-reply@example.com>"

# Cloudinary is optional in development until an upload endpoint is used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
